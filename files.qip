set_global_assignment -name QIP_FILE rtl/jtframe.qip
set_global_assignment -name QIP_FILE rtl/game.qip
set_global_assignment -name QIP_FILE rtl/dogyuun/dogyuun.qip
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-Dogyuun.sv
set_global_assignment -name SDC_FILE Arcade-Dogyuun.sdc

# Resolve bare upstream initialization filenames without copying them into the
# project root. These paths are retained now so later CPU/audio stages do not
# silently change the restored framework contract.
set_global_assignment -name SEARCH_PATH rtl/modules/jtframe/bin
set_global_assignment -name SEARCH_PATH rtl/modules/jt6295/hdl
set_global_assignment -name SEARCH_PATH rtl/modules/fx68k/hdl
